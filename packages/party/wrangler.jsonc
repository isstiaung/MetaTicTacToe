{
  // Cloudflare Workers config. Deploys to https://metatictactoe.<account>.workers.dev
  // (free; no custom domain needed). One Durable Object per match room.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metatictactoe",
  "main": "src/server.ts",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    // Binding name "Main" -> partyserver maps it to the default party "main"
    // that partysocket uses, so the clients connect unchanged.
    "bindings": [{ "name": "Main", "class_name": "GameServer" }]
  },
  "migrations": [
    // SQLite-backed Durable Objects: required for hibernation and available on the free plan.
    { "tag": "v1", "new_sqlite_classes": ["GameServer"] }
  ],
  // Abuse prevention: non-secret config lives here; secrets are set out-of-band (see below).
  "vars": {
    // CORS allow-origin for POST /auth. Tighten to your web origin in production, e.g.
    // "https://metatictactoe-web.pages.dev". "*" is fine since /auth itself requires a Turnstile solve.
    "WEB_ORIGIN": "*"
  },
  // Per-IP rate limits (free, colo-local best-effort). period must be 10 or 60 (seconds).
  "ratelimits": [
    // Session-token minting — the expensive path (one Turnstile verify + a 12h token each).
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    // Socket connections — generous enough for real reconnects, murder for floods.
    { "name": "CONNECT_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
  // Secrets (set with `wrangler secret put <NAME>`; the gate is OFF until both are set):
  //   TURNSTILE_SECRET  — Turnstile secret key (server-side challenge verification)
  //   AUTH_SECRET       — random string used to HMAC-sign session tokens (e.g. `openssl rand -hex 32`)
}
