# PartyKit host for online play. Read at BUILD time — Vite inlines it into the bundle.
#
# Local dev (if unset, the app defaults to 127.0.0.1:1999).
# Production: your deployed PartyKit host, e.g. metatictactoe.<account>.partykit.dev
#
# On Cloudflare Pages, set this as a build environment variable in the dashboard
# (Settings → Environment variables) rather than committing a real value here.
VITE_PARTYKIT_HOST=127.0.0.1:1999
