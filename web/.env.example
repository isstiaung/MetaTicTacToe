# PartyKit host for online play. Read at BUILD time — Vite inlines it into the bundle.
#
# Local dev (if unset, the app defaults to 127.0.0.1:1999).
# Production: your deployed PartyKit host, e.g. metatictactoe.<account>.partykit.dev
#
# On Cloudflare Pages, set this as a build environment variable in the dashboard
# (Settings → Environment variables) rather than committing a real value here.
VITE_PARTYKIT_HOST=127.0.0.1:1999

# Cloudflare Turnstile SITE key (public — safe to ship) for the online abuse gate.
# Read at BUILD time. If unset, the app uses Cloudflare's always-pass TEST key, which is
# correct for local dev but NOT for production. In production set your real site key here
# (or in the Pages dashboard) AND set the matching TURNSTILE_SECRET + AUTH_SECRET worker
# secrets (see DEPLOY.md) — otherwise the gate is misconfigured and online play won't connect.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
