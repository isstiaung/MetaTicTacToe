# Game-server host for online play (the `@mtt/party` Cloudflare Worker). Read at BUILD time —
# Vite inlines it into the bundle.
#
# Local dev (if unset, the app defaults to 127.0.0.1:1999 — `npm run dev -w @mtt/party`).
# Production: your game-server Worker's host, e.g. party.example.com or
# metatictactoe.<account>.workers.dev
#
# With Cloudflare Workers Builds, set this as a build variable on the web Worker in the dashboard
# rather than committing a real value here (see DEPLOY.md). For local production builds, use
# web/.env.production.local (gitignored).
VITE_PARTYKIT_HOST=127.0.0.1:1999

# Cloudflare Turnstile SITE key (public — safe to ship) for the online abuse gate.
# Read at BUILD time. If unset, the app uses Cloudflare's always-pass TEST key, which is
# correct for local dev but NOT for production. In production set your real site key here
# (or as a Workers Builds build variable) AND set the matching TURNSTILE_SECRET + AUTH_SECRET worker
# secrets (see DEPLOY.md) — otherwise the gate is misconfigured and online play won't connect.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
